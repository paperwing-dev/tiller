{
  "name": "@paperwing/tiller-installer",
  "version": "0.4.10",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build-input": "node scripts/generate-stable-release.mjs --development",
    "build-input:release": "node scripts/generate-stable-release.mjs",
    "prebuild": "npm run build-input",
    "build": "tsc -p tsconfig.json --noEmit",
    "predev": "npm run build-input",
    "dev": "wrangler dev",
    "predeploy": "npm run build-input:release",
    "deploy": "wrangler deploy",
    "pretest": "npm run build-input",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.119.0"
  }
}
