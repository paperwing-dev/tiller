# Copy this file to `.update-self-host-dev.local.env` at the repo root and set
# the values for your machine. That is the only self-host file you should edit.
# The scripts also create gitignored state files:
# - `.update-self-host-deploy-record.json`
# Root full and Tiller-only deploys update this target automatically. To update
# it independently of a deploy, run:
#   npm run update-host:local-env
# Existing workload containers are preserved across this path.

# Required for default usage:
# Pick one of these shapes:
# 1. Single target
# SELF_HOST_TARGET=user@mac-mini.local
#
# 2. Prefer a local LAN address, but fall back to a remote address like
#    Tailscale when the local one is unreachable.
# SELF_HOST_TARGET_LOCAL=user@192.168.8.10
# SELF_HOST_TARGET_REMOTE=user@100.64.0.10
SELF_HOST_TARGET=user@mac-mini.local

# Maintainer validation update:
#   npm run update-host:local-env
